{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(sed:*)",
      "Bash(node:*)",
      "Bash(npm install:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(npm run build:*)",
      "Bash(for lang in de es fr ru)",
      "Bash(do echo \"=== $lang ===\")",
      "Bash(done)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx next build:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx expo install expo-clipboard)",
      "Bash(pnpm add expo-clipboard)",
      "Bash(npx acorn:*)",
      "WebSearch",
      "Bash(npx next:*)",
      "WebFetch(domain:restcountries.com)",
      "Bash(git *)",
      "Bash(git diff *)",
      "Bash(git push:*)",
      "Read(//tmp/**)",
      "Bash(npx tsc *)",
      "Read(//usr/share/xsessions/**)",
      "Bash(journalctl --user -b 0 -p err --no-pager)",
      "Bash(journalctl -b 0 --no-pager)",
      "Bash(sudo cat *)",
      "Bash(sudo cp *)",
      "Bash(sudo ls *)",
      "Bash(sudo tee *)",
      "Bash(git show *)",
      "PowerShell(node --check serverUtils/eloRefunds.js; node --check serverUtils/purgeUserCascade.js; node --check scripts/backfillRefundedDuelWinLoss.js; node --check scripts/resolveOrphanedReports.js; node --check api/mod/takeAction.js; node --check api/mod/getReports.js; node --check api/eloRank.js; node --check models/Game.js; node --check models/Report.js; Write-Output 'ALL SYNTAX OK')"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop."
}
