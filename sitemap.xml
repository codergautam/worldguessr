<?xml version="1.0" encoding="UTF-8"?>
<!-- Static fallback sitemap index. In production the edge Worker
     (workers/seo-edge) serves /sitemap.xml itself, sized from the live map
     count, so this file is only what crawlers get when the Worker is off.
     sitemap-pages.xml is written into the export by scripts/writeSitemap.mjs
     after every build (static pages + official country maps, build-date
     lastmod). sitemap-maps-N.xml are 45,000-map pages from the API. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://www.worldguessr.com/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://www.worldguessr.com/sitemap-maps-1.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://www.worldguessr.com/sitemap-maps-2.xml</loc>
  </sitemap>
</sitemapindex>
