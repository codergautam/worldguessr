{
  // SEO edge Worker for www.worldguessr.com. See README.md in this folder.
  //
  // Sits on two routes in front of the Cloudflare Pages site:
  //   /map*             per-map HTML: real <title>, description, canonical,
  //                     JSON-LD and crawlable map facts, built from the
  //                     public map API at request time. Every map, no rebuild.
  //   /sitemap-maps.xml the community-map sitemap, proxied from the API.
  //   /about            the live community-map count written into the page.
  // Everything else on the host never touches this Worker. The homepage in
  // particular stays off it on purpose.
  "name": "worldguessr-seo-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    { "pattern": "www.worldguessr.com/map*", "zone_name": "worldguessr.com" },
    { "pattern": "www.worldguessr.com/sitemap-maps.xml", "zone_name": "worldguessr.com" },
    { "pattern": "www.worldguessr.com/about", "zone_name": "worldguessr.com" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://www.worldguessr.com",
    "API_ORIGIN": "https://api.worldguessr.com"
  }
}
